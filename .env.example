# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
ALLOWED_CHAT_IDS=              # comma-separated; send /myid to the bot to find yours

# --- Mode: paper (simulated, default) or live (REAL MONEY) ---
TRADING_MODE=paper
LIVE_CONFIRM=                  # must be exactly "I_ACCEPT_THE_RISK" for live mode

# --- Exchange (crypto, via ccxt) ---
EXCHANGE=binance
API_KEY=                       # live only; create a key WITHOUT withdrawal permission
API_SECRET=
SYMBOL=BTC/USDT
TIMEFRAME=1h

# --- Strategy: SMA crossover + RSI filter ---
FAST_SMA=10
SLOW_SMA=30
RSI_PERIOD=14
RSI_MAX_BUY=70

# --- Risk ---
TRADE_SIZE_QUOTE=50            # amount of quote currency (USDT) per entry
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
DAILY_LOSS_LIMIT_PCT=5         # halts trading for the day if equity falls this much
PAPER_START_BALANCE=1000
POLL_SECONDS=30
