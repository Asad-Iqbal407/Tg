# Copy this file to .env for local runs and for docker compose, then replace every placeholder.
# .env is ignored by git and by the Docker build context. Never commit a file that holds real values.
# On a hosting platform, set the same names as secrets or environment variables instead of using a file.
# server/README.md describes every variable.

# API server. Keep PORT at 8787 for docker compose: the image's health check and nginx both use it.
PORT=8787
HOST=0.0.0.0

# MongoDB Atlas. USER, PASSWORD and HOST are placeholders. Replace them locally or as a platform secret.
# URL-encode any special character in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DB=neon_arcade

# mongo uses MONGODB_URI. memory keeps data in RAM and needs no database (development only).
DATA_STORE=mongo

# The exact origin the browser app is served from. Compose serves it at http://localhost:8080.
# For npm run dev, use http://localhost:5173.
APP_ORIGIN=http://localhost:8080

# Adds the Secure attribute to the session cookie. Set true for any site served over HTTPS.
COOKIE_SECURE=false

# Trust the client address from nginx's X-Forwarded-For. Compose sets this itself. Set false only when the
# API is exposed directly to clients with no proxy in front of it.
TRUST_PROXY=true
